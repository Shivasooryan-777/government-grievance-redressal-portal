    ->     u.name AS citizen_name,
    ->     u.phone_number,
    ->     g.tracking_id,
    ->     g.subject,
    ->     g.priority,
    ->     g.status
    -> FROM users u
    -> INNER JOIN grievances g
    ->     ON u.id = g.citizen_id;
