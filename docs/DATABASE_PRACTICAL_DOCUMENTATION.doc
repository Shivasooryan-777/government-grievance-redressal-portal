## 3. Table Creation & Key Constraints

The schema utilizes `BIGINT` primary keys with `AUTO_INCREMENT` for high scalability and indexing performance. Foreign keys enforce referential integrity with cascading constraints where appropriate. `UNIQUE` constraints are defined on citizen emails, department codes, grievance tracking IDs, and post-resolution feedback foreign keys.

### Complete DDL Script

```sql
CREATE DATABASE IF NOT EXISTS grievance_db;
USE grievance_db;

-- 1. DEPARTMENTS TABLE
CREATE TABLE departments (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    code VARCHAR(20) NOT NULL UNIQUE,
    description VARCHAR(255),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. USERS TABLE
CREATE TABLE users (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    phone_number VARCHAR(20),
    role ENUM('CITIZEN', 'GRO') NOT NULL,
    department_id BIGINT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_user_department 
        FOREIGN KEY (department_id) REFERENCES departments(id) 
        ON DELETE SET NULL ON UPDATE CASCADE
);

-- 3. GRIEVANCES TABLE
CREATE TABLE grievances (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    tracking_id VARCHAR(50) NOT NULL UNIQUE,
    subject VARCHAR(200) NOT NULL,
    description TEXT NOT NULL,
    status ENUM('PENDING', 'IN_PROGRESS', 'RESOLVED', 'REJECTED') NOT NULL DEFAULT 'PENDING',
    priority ENUM('LOW', 'MEDIUM', 'HIGH') NOT NULL DEFAULT 'MEDIUM',
    citizen_id BIGINT NOT NULL,
    department_id BIGINT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_grievance_citizen 
        FOREIGN KEY (citizen_id) REFERENCES users(id) 
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_grievance_department 
        FOREIGN KEY (department_id) REFERENCES departments(id) 
        ON DELETE SET NULL ON UPDATE CASCADE
);

-- 4. RESOLUTION LOGS TABLE
CREATE TABLE resolution_logs (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    grievance_id BIGINT NOT NULL,
    gro_id BIGINT NOT NULL,
    action_taken VARCHAR(255) NOT NULL,
    remarks TEXT NOT NULL,
    logged_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_resolution_grievance 
        FOREIGN KEY (grievance_id) REFERENCES grievances(id) 
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_resolution_gro 
        FOREIGN KEY (gro_id) REFERENCES users(id) 
        ON DELETE RESTRICT ON UPDATE CASCADE
);

-- 5. FEEDBACKS TABLE
CREATE TABLE feedbacks (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    grievance_id BIGINT NOT NULL UNIQUE,
    rating INT NOT NULL,
    comment TEXT,
    is_appealed BOOLEAN NOT NULL DEFAULT FALSE,
    submitted_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_feedback_rating CHECK (rating BETWEEN 1 AND 5),
    CONSTRAINT fk_feedback_grievance 
        FOREIGN KEY (grievance_id) REFERENCES grievances(id) 
        ON DELETE CASCADE ON UPDATE CASCADE
);
```

